# Inclusive AI Classroom Copilot - Environment Variables
# Copy this file to .env and fill in values

# Groq API Configuration (optional - app runs in labelled demo mode without a key)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Server Configuration
PORT=3001
NODE_ENV=development

# Comma-separated exact browser origins allowed by the backend.
# In Render, replace with your deployed Netlify origin (and optionally keep local origins).
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

